@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Core Xml)
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(ACCOUNTS_GLIB REQUIRED IMPORTED_TARGET libaccounts-glib glib-2.0 gobject-2.0)

include("${CMAKE_CURRENT_LIST_DIR}/AccountsQt6Targets.cmake")

set(ACCOUNTSQT_LIBRARIES AccountsQt6::AccountsQt6)
set(ACCOUNTSQT_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/accounts-qt6")
